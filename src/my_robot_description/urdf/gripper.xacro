<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. 夹持器底座 -->
    <link name="gripper_base_link">
        <visual>
            <geometry><box size="0.2 0.06 0.02" /></geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry><box size="0.2 0.06 0.02" /></geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.5" />
            <origin xyz="0 0 0.01" />
            <inertia ixx="0.00016667" ixy="0" ixz="0" iyy="0.00168333" iyz="0" izz="0.00181667" />
        </inertial>
    </link>

    <!-- 2. 左手指 -->
    <link name="gripper_left_finger_link">
        <visual>
            <geometry><box size="0.03 0.06 0.08" /></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry><box size="0.03 0.06 0.08" /></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.12" />
            <origin xyz="0 0 0.04" />
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000073" iyz="0" izz="0.000045" />
        </inertial>
    </link>

    <!-- 3. 右手指 -->
    <link name="gripper_right_finger_link">
        <visual>
            <geometry><box size="0.03 0.06 0.08" /></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry><box size="0.03 0.06 0.08" /></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.12" />
            <origin xyz="0 0 0.04" />
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000073" iyz="0" izz="0.000045" />
        </inertial>
    </link>

    <!-- 4. 关节定义 (现在是两个互相独立的平移关节) -->
    <joint name="gripper_left_finger_joint" type="prismatic">
        <parent link="gripper_base_link" />
        <child link="gripper_left_finger_link" />
        <origin xyz="-0.07 0 0.02" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="40.0" velocity="0.05" lower="0.0" upper="0.04" />
        <dynamics damping="20.0" friction="2.0" />
    </joint>

    <joint name="gripper_right_finger_joint" type="prismatic">
        <parent link="gripper_base_link" />
        <child link="gripper_right_finger_link" />
        <origin xyz="0.07 0 0.02" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="40.0" velocity="0.05" lower="-0.04" upper="0.0" />
        <dynamics damping="20.0" friction="2.0" />
    </joint>


</robot>
