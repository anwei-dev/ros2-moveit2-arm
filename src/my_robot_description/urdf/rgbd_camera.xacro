<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rgbd_camera" params="parent_link camera_name xyz rpy">
    <link name="${camera_name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.04 0.04" />
        </geometry>
        <material name="blue" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.04 0.04" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.08" />
        <inertia ixx="0.00003" ixy="0.0" ixz="0.0" iyy="0.00003" iyz="0.0" izz="0.00003" />
      </inertial>
    </link>

    <joint name="${camera_name}_joint" type="fixed">
      <parent link="${parent_link}" />
      <child link="${camera_name}" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <link name="${camera_name}_optical">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
      </inertial>
    </link>

    <joint name="${camera_name}_optical_joint" type="fixed">
      <parent link="${camera_name}" />
      <child link="${camera_name}_optical" />
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
    </joint>

    <gazebo reference="${camera_name}">
      <sensor name="${camera_name}_sensor" type="depth">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
        <plugin name="${camera_name}_plugin" filename="libgazebo_ros_camera.so">
          <camera_name>${camera_name}</camera_name>
          <frame_name>${camera_name}_optical</frame_name>
          <image_topic_name>/camera/rgb/image_raw</image_topic_name>
          <camera_info_topic_name>/camera/rgb/camera_info</camera_info_topic_name>
          <depth_image_topic_name>/camera/depth/image_raw</depth_image_topic_name>
          <depth_image_camera_info_topic_name>/camera/depth/camera_info</depth_image_camera_info_topic_name>
          <point_cloud_topic_name>/camera/depth/points</point_cloud_topic_name>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${camera_name}">
      <material>Gazebo/Blue</material>
    </gazebo>

  </xacro:macro>

</robot>
